# Ignore Python cache and environment
__pycache__/
*.pyc
*.egg-info/
venv/
.env
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Virtual env
.venv/

# Ignore OS specific files
.DS_Store
Thumbs.db

# Generated workdirs / artifacts
workdir*/

# Ignore data folders (too large for GitHub)
data/

# Allow a small sample for the README
!data/sample_output/

# Ignore output directories (generated artifacts)
output/
*.jsonl
# Corpus reconciliation manifest is a committed source-of-truth (PLAN_F1 WP-B/D1)
!corpus_manifest.jsonl

# Ignore conda environment
env/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Claude Code session state (scheduled tasks, local settings)
.claude/

# Cache files
.vision_cache.json

# Old documents
docs/archive-do not use

# Local pre-change backups of tracked files (redundant with git history)
*.pre_p1_bak

# Session scratch / handover docs (network topology, ssh targets) — keep out of git
HANDOVER_*.md
SMOKE_*.md
*OVERNIGHT_REPORT*.md

# Run logs (extraction/ingest/soak output) — local-only noise
logs/
